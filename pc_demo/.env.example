# Public YouTube metadata requires an API key. Restrict it to YouTube Data API v3.
YOUTUBE_API_KEY=

# Product configuration
CINKATKO_HANDLE=@mitoncz
MIN_EPISODE_SECONDS=600

# Optional emergency fallback. Set this to an approved YouTube video ID only.
FALLBACK_VIDEO_ID=

# Multilingual models have no ".en" suffix. "base" is a good Windows starting point.
WHISPER_MODEL=base
STT_LANGUAGE=auto

# Optional substring used to choose the microphone. Matching is case-insensitive.
AUDIO_DEVICE=respeaker
