# Enable YouTube Data API v3 and create a restricted API key.
YOUTUBE_API_KEY=

# Fixed allowlisted channel and product definition of "latest podcast".
CINKATKO_HANDLE=@mitoncz
MIN_EPISODE_SECONDS=600

# Optional cloud semantic router. Keep the real key only in .env on the Pi.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_TIMEOUT_SECONDS=4.0

# Optional bounded Hermes Agent sidecar. HERMES_API_KEY must equal
# API_SERVER_KEY in /home/voiceagent/.hermes/.env.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_API_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=25.0

# Optional local semantic router. The bundled user service listens only on loopback.
# When both are configured, this becomes the offline fallback for OpenRouter.
LOCAL_LLM_URL=http://127.0.0.1:8767

# Optional ATOMS3U smart-TV connector. Production excludes Bluetooth/NimBLE;
# leave both transport fields empty until configure_connector.py enrolls the
# device. Keep generic-usb-hid-v1 for TVs that accept USB remote keys. Use
# sony-bravia-ir-v1 for Sony Bravia IR, lg-tv-ir-v1 for LG TV IR, or
# lg-webos-hybrid-v1 for LG IR remote keys plus USB HID search and text entry.
# The hybrid profile requires both IR line of sight and a TV USB data port.
# A loopback URL may point to connector_simulator.py during development.
TV_CONNECTOR_BLE_NAME=
# Example after enrollment: TV_CONNECTOR_URL=http://192.168.1.50:80
TV_CONNECTOR_URL=
TV_CONNECTOR_KEY_FILE=
TV_CONNECTOR_PROFILE=generic-usb-hid-v1
TV_CONNECTOR_TIMEOUT_SECONDS=8.0
